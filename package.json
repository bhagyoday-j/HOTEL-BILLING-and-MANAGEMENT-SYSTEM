    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.0",
    "vite": "^5.0.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.0.0",
    "autoprefixer": "^10.0.0",
    "shadcn-ui": "^0.4.0",
    "zod": "^3.22.0",
    "react-hook-form": "^7.45.0",
    "@hookform/resolvers": "^3.4.0",
    "prisma": "^5.12.0",
    "decimal.js": "^10.4.3",
    "pino": "^9.0.0",
    "pino-pretty": "^10.0.0",
    "express": "^4.18.2",
