    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc && electron-builder",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "prisma": "prisma"
  },
  "devDependencies": {
