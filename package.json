{
  "name": "hotel-billing",
  "version": "1.0.1",
  "description": "Offline-capable Windows desktop app for hotel menu management, customer billing, receipt printing and owner analytics.",
  "author": "Hotel Billing Systems",
  "main": "apps/desktop/electron/dist/main.js",
  "scripts": {
    "dev": "concurrently -n api,renderer \"npm:dev:server\" \"npm:dev:renderer\"",
    "dev:electron": "tsc -p apps/desktop/electron/tsconfig.json && cross-env NODE_ENV=development electron apps/desktop/electron/dist/main.js",
    "dev:renderer": "npm run dev --workspace apps/desktop/renderer",
    "build": "npm run build:shared && npm run build:server && npm run build:renderer && npm run build:electron",
    "build:shared": "tsc -p packages/shared/tsconfig.json",
    "build:server": "tsc -p apps/server/tsconfig.json",
    "build:renderer": "npm run build --workspace apps/desktop/renderer",
    "build:electron": "tsc -p apps/desktop/electron/tsconfig.json",
    "package": "npm run build && electron-builder --dir",
    "installer": "npm run build && electron-builder --publish never",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest --run",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "license:key": "tsx scripts/license-key.ts",
    "dev:server": "npm run dev --workspace apps/server",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:server && npm run typecheck:electron",
    "typecheck:renderer": "tsc -p apps/desktop/renderer/tsconfig.json --noEmit",
    "typecheck:server": "tsc -p apps/server/tsconfig.json --noEmit",
    "typecheck:electron": "tsc -p apps/desktop/electron/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@electron/remote": "^2.0.0",
    "@hookform/resolvers": "^3.4.0",
    "@tanstack/react-query": "^4.0.0",
    "@tanstack/react-query-devtools": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.0.0",
    "prettier": "^3.0.0",
    "prisma": "^5.12.0",
    "react-hook-form": "^7.45.0",
    "shadcn-ui": "^0.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@prisma/client": "^5.12.0",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "decimal.js": "^10.5.0",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.12.0",
    "zod": "^3.24.2",
    "zustand": "^4.5.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/desktop/renderer"
  ]
}
