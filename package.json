{
  "name": "hotel-billing",
  "version": "1.0.0",
  "main": "apps/desktop/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:electron\" \"npm:dev:renderer\"",
    "dev:electron": "cross-env NODE_ENV=development electron .",
